{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game-night",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server/index.js"],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "game-night-online",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server/index.js", "--online", "--port", "3100"],
      "port": 3100,
      "url": "http://localhost:3100"
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "site"],
      "port": 4000,
      "url": "http://localhost:4000"
    }
  ]
}
